From 5de987a32f24c00351b62794dcbab252820dd6c4 Mon Sep 17 00:00:00 2001
From: Lesson 8 local preparation <local-preparation@example.invalid>
Date: Sun, 4 Oct 2026 22:16:39 +0000
Subject: [PATCH 06/10] author links

---
 templates/partials/_post_card.html | 2 +-
 templates/post_detail.html         | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/templates/partials/_post_card.html b/templates/partials/_post_card.html
index 717fb41..710e21c 100644
--- a/templates/partials/_post_card.html
+++ b/templates/partials/_post_card.html
@@ -6,7 +6,7 @@
     <h2><a href="{% url 'blog:post_detail' post.id %}">{{ post.title }}</a></h2>
     <p class="excerpt">{{ post.content|truncatewords:25 }}</p>
     <div class="post-card-bottom">
-        <span class="author">@{{ post.author }}</span>
+        <a class="author" href="{% url 'blog:author_posts' post.author %}">@{{ post.author }}</a>
         <a class="text-link" href="{% url 'blog:post_detail' post.id %}">Ətraflı oxu <span aria-hidden="true">→</span></a>
     </div>
 </article>
diff --git a/templates/post_detail.html b/templates/post_detail.html
index 3e9c11a..6952ba4 100644
--- a/templates/post_detail.html
+++ b/templates/post_detail.html
@@ -4,7 +4,7 @@
 <article class="paper reading-width">
     <div class="post-card-top"><span class="pill">{{ post.category }}</span><time datetime="{{ post.created_at|date:'Y-m-d' }}">{{ post.created_at|date:"d.m.Y" }}</time></div>
     <h1>{{ post.title }}</h1>
-    <p class="byline">Müəllif: <span class="author">@{{ post.author }}</span></p>
+    <p class="byline">Müəllif: <a class="author" href="{% url 'blog:author_posts' post.author %}">@{{ post.author }}</a></p>
     <div class="article-body">{{ post.content|linebreaks }}</div>
     <a class="text-link back-link" href="{% url 'blog:post_list' %}">← Bütün postlar</a>
 </article>
-- 
