diff --git a/templates/base.html b/templates/base.html
new file mode 100644
index 0000000..cc17c6d
--- /dev/null
+++ b/templates/base.html
@@ -0,0 +1,30 @@
+{% load static %}
+<!DOCTYPE html>
+<html lang="az">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <meta name="description" content="STEP IT Academy - Python və maraqlı mövzularda blog">
+    <title>{% block title %}STEP Blog{% endblock %} | STEP Blog</title>
+    <link rel="stylesheet" href="{% static 'css/style.css' %}">
+</head>
+<body>
+    <header class="site-header">
+        <div class="shell header-inner">
+            <a href="{% url 'blog:post_list' %}" class="brand" aria-label="STEP Blog - Ana səhifə"><span class="brand-mark">S</span>STEP <strong>Blog</strong></a>
+            <nav class="navbar" aria-label="Əsas menyu">
+                <a href="{% url 'blog:post_list' %}">Postlar</a>
+                <a href="{% url 'blog:category_list' %}">Kateqoriyalar</a>
+                <a href="{% url 'blog:about' %}">Haqqımızda</a>
+            </nav>
+        </div>
+    </header>
+    <main class="shell main-content">
+        {% block content %}{% endblock %}
+    </main>
+    <footer class="site-footer">
+        <div class="shell footer-inner"><span>STEP IT Academy · Python Web Development</span><span>© 2026 STEP Blog</span></div>
+    </footer>
+    <script src="{% static 'js/app.js' %}"></script>
+</body>
+</html>
diff --git a/templates/categories.html b/templates/categories.html
new file mode 100644
index 0000000..67eb905
--- /dev/null
+++ b/templates/categories.html
@@ -0,0 +1,16 @@
+{% extends "base.html" %}
+{% block title %}Kateqoriyalar{% endblock %}
+{% block content %}
+<div class="section-head"><h1>Kateqoriyalar</h1><span class="muted">{{ categories|length }} kateqoriya</span></div>
+<div class="card-grid">
+    {% for category in categories %}
+    <article class="post-card category-card">
+        <h2><a href="{% url 'blog:category_detail' category.slug %}">{{ category.name }}</a></h2>
+        <p>{{ category.description }}</p>
+        <a class="text-link" href="{% url 'blog:category_detail' category.slug %}">Yazılara bax →</a>
+    </article>
+    {% empty %}
+        <p class="empty-state">Kateqoriya yoxdur.</p>
+    {% endfor %}
+</div>
+{% endblock %}
diff --git a/templates/category_detail.html b/templates/category_detail.html
new file mode 100644
index 0000000..56777cd
--- /dev/null
+++ b/templates/category_detail.html
@@ -0,0 +1,16 @@
+{% extends "base.html" %}
+{% block title %}{{ category.name }}{% endblock %}
+{% block content %}
+<section class="page-intro">
+    <p class="eyebrow">Kateqoriya</p>
+    <h1>{{ category.name }}</h1>
+    <p>{{ category.description }}</p>
+</section>
+<div class="card-grid">
+    {% for post in posts %}
+        {% include "partials/_post_card.html" %}
+    {% empty %}
+        <p class="empty-state">Bu kateqoriyada hələ post yoxdur.</p>
+    {% endfor %}
+</div>
+{% endblock %}
